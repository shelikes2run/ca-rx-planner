   "label": "Weather Evaluator – map-selected unit",
   "config": {
    "embedType": "url",
    "expression": "<p>https://shelikes2run.github.io/ca-rx-planner/burn_eval_ca.html?unit=<exp data-uniqueid=\"1x_n\" data-dsid=\"dataSource_1-treatment_units-selection\" data-expression=\"%7B%22name%22%3A%22%7BName%7D%22%2C%22parts%22%3A%5B%7B%22type%22%3A%22FIELD%22%2C%22exp%22%3A%22%7BName%7D%22%2C%22dataSourceId%22%3A%22dataSource_1-treatment_units-selection%22%2C%22jimuFieldName%22%3A%22name%22%2C%22isFromRepeatedDataSourceContext%22%3Afalse%7D%5D%7D\">﻿<span contenteditable=\"false\">{Name}</span>﻿</exp>&amp;id=<exp data-uniqueid=\"1x_i\" data-dsid=\"dataSource_1-treatment_units-selection\" data-expression=\"%7B%22name%22%3A%22%7BObject%20ID%7D%22%2C%22parts%22%3A%5B%7B%22type%22%3A%22FIELD%22%2C%22exp%22%3A%22%7BObject%20ID%7D%22%2C%22dataSourceId%22%3A%22dataSource_1-treatment_units-selection%22%2C%22jimuFieldName%22%3A%22objectid%22%2C%22isFromRepeatedDataSourceContext%22%3Afalse%7D%5D%7D\">﻿<span contenteditable=\"false\">{Object ID}</span>﻿</exp></p>",
    "enableLabel": true,
    "label": "Click a fuel treatment unit on the map to run it here.",
    "enableBlankMessage": true,
    "blankMessage": "Click a fuel treatment unit on the map to run it here. To upload your own unit, search by name, or enter coordinates, use the \"Search / upload unit & Rx\" tab above.",
