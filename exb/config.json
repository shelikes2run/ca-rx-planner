 "widgets": {
  "w_title": {
   "uri": "widgets/common/text/",
   "version": "1.21.0",
   "id": "w_title",
   "label": "Title",
   "config": {
    "text": "<p><strong style=\"font-size:18px;color:#ffffff;\">CA Prescribed Fire Planner</strong><span style=\"font-size:13px;color:#dbe7f3;\"> (Beta) · burn windows, smoke, outlooks, typical burn days</span></p>",
    "style": {
     "verticalAlign": "start",
     "wrap": true
    }
   }
  },
  "w_menu": {
   "uri": "widgets/common/menu/",
   "version": "1.21.0",
   "id": "w_menu",
   "label": "Menu",
   "config": {
    "type": "nav",
    "vertical": false,
    "menuStyle": "pills",
    "advanced": true,
    "variants": {
     "default": {
      "item": {
       "default": {
        "color": "#dbe7f3"
       },
       "hover": {
        "color": "#ffffff",
        "bg": "#14548a"
       },
       "active": {
        "color": "#0b3b63",
        "bg": "#ffffff"
       }
      }
     }
    }
   },
   "style": {
    "background": {
     "color": "#0b3b63",
     "fillType": "fill"
    },
    "textColor": "#ffffff"
   }
  },
  "w_map1": {
   "uri": "widgets/arcgis/arcgis-map/",
   "version": "1.21.0",
   "id": "w_map1",
   "label": "Weather Evaluator Map",
   "config": {
    "toolConfig": {
     "canZoom": true,
     "canHome": true,
     "canSearch": false,
     "canNavigation": true,
     "canBaseMap": true,
     "canMeasure": true,
     "canFullScreen": true,
