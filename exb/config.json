     "canSelect": false,
     "canExtentNavigate": false,
     "canOverviewMap": false
    },
    "isUseCustomMapState": false,
    "initialMapDataSourceID": "dataSource_1",
    "initialMapState": null,
    "disablePopUp": true,
    "showPopupUponSelection": false,
    "clientQueryDataSourceIds": []
   },
   "useDataSources": [
    {
     "dataSourceId": "dataSource_1",
     "mainDataSourceId": "dataSource_1"
    }
   ],
   "layouts": {
    "MapFixedLayout": {
     "LARGE": "layout_map1"
    }
   }
  },
  "w_search1": {
   "uri": "widgets/common/search/",
   "version": "1.21.0",
   "id": "w_search1",
   "label": "Unit Search",
   "useMapWidgetIds": [
    "w_map1"
   ],
   "useUtilities": [
    {
     "utilityId": "utility_1"
    }
   ],
   "config": {
    "sourceType": "MapCentric",
    "searchResultView": "Result_Panel",
    "arrangementStyle": "Style1",
    "maxSuggestions": 6,
    "resultMaxNumber": 6,
    "enableFiltering": false,
    "isAutoSelectFirstResult": true,
    "dataSourceConfigWithMapCentric": {
     "w_map1-dataSource_1": {
      "dataSourceConfig": [
       {
        "configId": "cfg_units",
        "label": "Fuel Treatment Units",
        "displayLabel": true,
        "hint": "Search unit name",
        "searchServiceType": "FeatureService",
        "searchExact": false,
        "searchInCurrentMapExtent": false,
        "useDataSource": {
         "dataSourceId": "dataSource_1-treatment_units",
         "mainDataSourceId": "dataSource_1-treatment_units",
         "rootDataSourceId": "dataSource_1",
         "fields": [
          "name",
          "objectid"
         ]
        },
        "displayFields": [
         {
          "jimuName": "name",
          "name": "name",
          "type": "STRING",
          "esriType": "esriFieldTypeString",
          "alias": "Name"
         }
        ],
        "searchFields": [
         {
          "jimuName": "name",
          "name": "name",
          "type": "STRING",
          "esriType": "esriFieldTypeString",
          "alias": "Name"
         }
        ]
       },
       {
        "configId": "cfg_geocode",
        "label": "Place or address",
        "useUtility": {
         "utilityId": "utility_1"
        },
        "searchServiceType": "GeocodeService",
        "singleLineFieldName": "SingleLine",
        "isSupportSuggest": true,
        "outputDataSourceId": "w_search1_output_geocode"
       }
      ],
      "synchronizeSettings": false
     }
    }
   },
   "useDataSources": [
    {
     "dataSourceId": "dataSource_1-treatment_units",
     "mainDataSourceId": "dataSource_1-treatment_units",
     "rootDataSourceId": "dataSource_1",
     "fields": [
      "name",
      "objectid"
     ]
    }
   ],
   "outputDataSources": [
    "w_search1_output_geocode"
   ]
  },
  "w_help1": {
   "uri": "widgets/common/text/",
   "version": "1.21.0",
   "id": "w_help1",
   "label": "How to use",
   "config": {
    "text": "<p style=\"font-size:12px;\"><strong>Two ways in:</strong> click a fuel treatment unit, then open the <em>Unit selected on map</em> tab — or use the <em>Search / upload unit &amp; Rx</em> tab to search by name, upload a shapefile/KML/GeoJSON, or enter lat/lon. Set your Rx in either tab.</p>",
    "style": {
     "verticalAlign": "start",
     "wrap": true
    }
   },
   "style": {
    "background": {
     "color": "rgba(255,255,255,0.94)",
     "fillType": "fill"
    },
    "border": {
     "type": "solid",
     "color": "#c9d3dd",
     "width": "1px"
    },
    "borderRadius": {
     "number": [
      4,
      4,
      4,
      4
     ],
     "unit": "px"
    }
   }
  },
